# Copy to .env and adjust. Every value has a working default for the local demo.

# Ring Partner API. Default: the local ring-sandbox emulator.
RING_BASE_URL=http://127.0.0.1:8787
RING_TOKEN=sandbox-token
RING_SANDBOX=true
# Shared HMAC secret for webhook signatures (X-Signature: sha256=...).
WEBHOOK_SIGNING_KEY=heatwatch-demo-key
PUBLIC_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/ring
WEBHOOK_MAX_AGE_S=300

# How often the rules are evaluated, in real seconds. (Demo speed is chosen per replay.)
HEATWATCH_TICK_S=0.25

# Family access code. Empty = no login (local demo only). Set it for anything reachable by others.
HEATWATCH_ACCESS_CODE=

# Amazon Bedrock (optional): uses your normal AWS credentials (env vars, ~/.aws, SSO).
BEDROCK_ENABLED=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
